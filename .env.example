# Copy to .env. Never commit credentials.
HOST=127.0.0.1
PORT=4310
DATA_DIR=.data
APP_ORIGIN=http://localhost:5173
# Required when binding to a non-loopback host. Use a long random password.
APP_PASSWORD=
# Explicit test mode: no CLI or paid audio calls. UI labels this mode.
DEMO_MODE=false
MAX_CONCURRENT_RUNS=3
# Full autonomy in the dedicated container; keep false for local development.
AGENT_UNRESTRICTED=false
CLAUDE_BIN=claude
CODEX_BIN=codex
# CLI subscriptions only. No ANTHROPIC_API_KEY or OPENAI_API_KEY is passed to agents.
CLAUDE_CODE_OAUTH_TOKEN=
# Optional dedicated Codex home with its own subscription login:
# AGENT_CODEX_HOME=/data/home/.codex
OPENROUTER_API_KEY=
STT_MODEL=openai/gpt-4o-transcribe
TTS_MODEL=google/gemini-3.8-flash-lite-tts
TTS_VOICE=Kore
AUDIO_BASE_URL=https://openrouter.ai/api/v1
# npm run keys:vapid; keep these stable across restarts.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
